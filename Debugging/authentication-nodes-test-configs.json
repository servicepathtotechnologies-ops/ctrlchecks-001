{
  "oauth2": {
    "description": "OAuth2 authentication and token management",
    "testConfigs": {
      "get_access_token_authorization_code": {
        "operation": "get_access_token",
        "grantType": "authorization_code",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "tokenUrl": "https://oauth.example.com/token",
        "authorizationUrl": "https://oauth.example.com/authorize",
        "redirectUri": "https://yourapp.com/callback",
        "code": "authorization-code-here",
        "scope": "read write"
      },
      "get_access_token_client_credentials": {
        "operation": "get_access_token",
        "grantType": "client_credentials",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "tokenUrl": "https://oauth.example.com/token",
        "scope": "read write"
      },
      "refresh_token": {
        "operation": "refresh_token",
        "grantType": "refresh_token",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "tokenUrl": "https://oauth.example.com/token",
        "refreshToken": "refresh-token-here"
      },
      "validate_token": {
        "operation": "validate_token",
        "grantType": "authorization_code",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "tokenUrl": "https://oauth.example.com/token",
        "token": "access-token-to-validate"
      },
      "revoke_token": {
        "operation": "revoke_token",
        "grantType": "authorization_code",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "tokenUrl": "https://oauth.example.com/token",
        "token": "token-to-revoke"
      }
    }
  },
  "jwt": {
    "description": "JSON Web Token generation and verification",
    "testConfigs": {
      "sign_token": {
        "operation": "sign",
        "algorithm": "HS256",
        "secret": "your-secret-key",
        "payload": "{\"sub\": \"user123\", \"exp\": 1735689600, \"iat\": 1735686000, \"name\": \"John Doe\"}",
        "expiresIn": "1h"
      },
      "sign_token_rs256": {
        "operation": "sign",
        "algorithm": "RS256",
        "secret": "-----BEGIN PRIVATE KEY-----\\n...your private key...\\n-----END PRIVATE KEY-----",
        "payload": "{\"sub\": \"user123\", \"exp\": 1735689600}",
        "expiresIn": "24h"
      },
      "verify_token": {
        "operation": "verify",
        "algorithm": "HS256",
        "secret": "your-secret-key",
        "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyMTIzIn0..."
      },
      "decode_token": {
        "operation": "decode",
        "algorithm": "HS256",
        "secret": "your-secret-key",
        "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyMTIzIn0..."
      }
    }
  },
  "ldap": {
    "description": "LDAP authentication and directory operations",
    "testConfigs": {
      "authenticate": {
        "operation": "authenticate",
        "serverUrl": "ldap://ldap.example.com:389",
        "bindDn": "cn=admin,dc=example,dc=com",
        "bindPassword": "admin-password",
        "userDn": "uid=user,ou=users,dc=example,dc=com",
        "password": "user-password"
      },
      "authenticate_with_username": {
        "operation": "authenticate",
        "serverUrl": "ldap://ldap.example.com:389",
        "bindDn": "cn=admin,dc=example,dc=com",
        "bindPassword": "admin-password",
        "username": "username",
        "password": "user-password"
      },
      "search": {
        "operation": "search",
        "serverUrl": "ldap://ldap.example.com:389",
        "bindDn": "cn=admin,dc=example,dc=com",
        "bindPassword": "admin-password",
        "searchBase": "dc=example,dc=com",
        "searchFilter": "(uid=username)",
        "attributes": "[\"cn\", \"mail\", \"uid\", \"sn\"]"
      },
      "bind": {
        "operation": "bind",
        "serverUrl": "ldap://ldap.example.com:389",
        "bindDn": "cn=admin,dc=example,dc=com",
        "bindPassword": "admin-password"
      }
    }
  },
  "okta": {
    "description": "Okta SSO and identity management",
    "testConfigs": {
      "get_user": {
        "operation": "get_user",
        "domain": "dev-123456.okta.com",
        "apiToken": "your-api-token",
        "userId": "00u1abc23def456ghi"
      },
      "list_users": {
        "operation": "list_users",
        "domain": "dev-123456.okta.com",
        "apiToken": "your-api-token",
        "query": "status eq \"ACTIVE\"",
        "limit": 200
      },
      "list_users_with_email_filter": {
        "operation": "list_users",
        "domain": "dev-123456.okta.com",
        "apiToken": "your-api-token",
        "query": "profile.email eq \"user@example.com\"",
        "limit": 50
      },
      "create_user": {
        "operation": "create_user",
        "domain": "dev-123456.okta.com",
        "apiToken": "your-api-token",
        "userData": "{\"profile\": {\"firstName\": \"John\", \"lastName\": \"Doe\", \"email\": \"john@example.com\", \"login\": \"john@example.com\"}}"
      },
      "update_user": {
        "operation": "update_user",
        "domain": "dev-123456.okta.com",
        "apiToken": "your-api-token",
        "userId": "00u1abc23def456ghi",
        "userData": "{\"profile\": {\"firstName\": \"Jane\", \"lastName\": \"Smith\"}}"
      },
      "delete_user": {
        "operation": "delete_user",
        "domain": "dev-123456.okta.com",
        "apiToken": "your-api-token",
        "userId": "00u1abc23def456ghi"
      },
      "authenticate_user": {
        "operation": "authenticate_user",
        "domain": "dev-123456.okta.com",
        "apiToken": "your-api-token",
        "username": "user@example.com",
        "password": "user-password"
      }
    }
  },
  "auth0": {
    "description": "Auth0 identity and access management",
    "testConfigs": {
      "get_user": {
        "operation": "get_user",
        "domain": "dev-abc123.us.auth0.com",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "userId": "auth0|123456789"
      },
      "list_users": {
        "operation": "list_users",
        "domain": "dev-abc123.us.auth0.com",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "query": "email:\"user@example.com\""
      },
      "create_user": {
        "operation": "create_user",
        "domain": "dev-abc123.us.auth0.com",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "userData": "{\"email\": \"user@example.com\", \"password\": \"Password123!\", \"connection\": \"Username-Password-Authentication\", \"name\": \"John Doe\"}"
      },
      "update_user": {
        "operation": "update_user",
        "domain": "dev-abc123.us.auth0.com",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "userId": "auth0|123456789",
        "userData": "{\"name\": \"Jane Doe\", \"nickname\": \"jane\"}"
      },
      "delete_user": {
        "operation": "delete_user",
        "domain": "dev-abc123.us.auth0.com",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "userId": "auth0|123456789"
      },
      "get_token": {
        "operation": "get_token",
        "domain": "dev-abc123.us.auth0.com",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "audience": "https://api.example.com",
        "scope": "read:users update:users"
      }
    }
  },
  "keycloak": {
    "description": "Keycloak identity and access management",
    "testConfigs": {
      "get_token": {
        "operation": "get_token",
        "serverUrl": "https://keycloak.example.com",
        "realm": "master",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "username": "user@example.com",
        "password": "user-password"
      },
      "refresh_token": {
        "operation": "refresh_token",
        "serverUrl": "https://keycloak.example.com",
        "realm": "master",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "refreshToken": "refresh-token-here"
      },
      "get_user": {
        "operation": "get_user",
        "serverUrl": "https://keycloak.example.com",
        "realm": "master",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "userId": "user-uuid-here"
      },
      "list_users": {
        "operation": "list_users",
        "serverUrl": "https://keycloak.example.com",
        "realm": "master",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret"
      },
      "create_user": {
        "operation": "create_user",
        "serverUrl": "https://keycloak.example.com",
        "realm": "master",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "username": "newuser",
        "email": "newuser@example.com",
        "firstName": "New",
        "lastName": "User",
        "enabled": true
      },
      "update_user": {
        "operation": "update_user",
        "serverUrl": "https://keycloak.example.com",
        "realm": "master",
        "clientId": "your-client-id",
        "clientSecret": "your-client-secret",
        "userId": "user-uuid-here",
        "firstName": "Updated",
        "lastName": "Name"
      }
    }
  }
}

